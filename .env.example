# Copy this file to .env and fill in real values before running docker-compose.
# Nothing in this repo has a real secret checked in.

# --- Core ---
DATABASE_URL=postgresql+asyncpg://sentrimesh:sentrimesh@postgres:5432/sentrimesh
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256

# --- Bootstrap admin (you) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# --- Claude API (optional — enables narrative reports/summaries; the
#     platform works without it using deterministic templates instead) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- IP reputation sources (all optional, all independent — Threat
#     Intelligence queries every one configured, in parallel, and
#     combines whatever comes back; set any subset. Without any of them,
#     enrichment honestly reports "unknown" verdicts, never a fabricated
#     one. See backend/app/connectors/threat_feed.py. ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
# abuse.ch's shared Auth-Key (https://auth.abuse.ch) — used for the
# ThreatFox indicator-of-compromise lookup.
ABUSECH_AUTH_KEY=

# --- ipinfo.io (optional — real IP-to-country lookups for impossible-
#     travel detection, when the event source didn't already supply a
#     country itself — Azure AD sign-in logs do; Wazuh/CloudTrail don't.
#     Without this, impossible-travel only evaluates events whose source
#     already carries location data.) ---
IPINFO_API_KEY=

# --- SerpAPI (optional — powers the Exposure agent's real Google-search
#     OSINT step: does the tenant's own domain turn up indexed alongside
#     exposure-indicating file types or a directory listing. Without it,
#     that one step is skipped; nothing else about exposure scanning
#     depends on it — see backend/app/connectors/exposure_scanner.py.) ---
SERPAPI_API_KEY=

# OSV.dev and the GitHub Advisory Database (dependency vulnerability
# scanning, backend/app/connectors/vuln_scanner.py) need no key — both
# are free, unauthenticated public APIs.

# --- Real response execution (optional, OFF by default). When true,
#     block_ip really firewalls the HOST THIS BACKEND RUNS ON via iptables.
#     Only enable this where the backend itself is your enforcement point
#     (e.g. an edge/gateway host) — see backend/app/connectors/executor.py. ---
ENABLE_REAL_RESPONSE_EXECUTION=false

# --- SMTP (optional — without it, notifications are logged, not sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourcompany.com
NOTIFY_TO_EMAIL=you@yourcompany.com

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
