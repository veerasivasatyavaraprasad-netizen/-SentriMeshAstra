# Copy this file to .env and fill in real values before running docker-compose.
# Nothing in this repo has a real secret checked in.

# --- Core ---
DATABASE_URL=postgresql+asyncpg://sentrimesh:sentrimesh@postgres:5432/sentrimesh
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256

# --- Bootstrap admin (you) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# --- Claude API (optional — enables narrative reports/summaries; the
#     platform works without it using deterministic templates instead) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- SMTP (optional — without it, notifications are logged, not sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourcompany.com
NOTIFY_TO_EMAIL=you@yourcompany.com

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
